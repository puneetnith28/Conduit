{
  "name": "conduit",
  "version": "1.0.0",
  "private": true,
  "description": "Human-driven control center for running and supervising multiple coding CLI agents in parallel.",
  "author": {
    "name": "Dev Prashant",
    "email": "adoranto737@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devprashant19/Conduit.git"
  },
  "main": "dist/electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k -n tsup,daemon,web,vite -c gray,magenta,cyan,green \"tsup --watch\" \"node --watch dist/src/daemon/daemon.mjs\" \"node --watch dist/src/server.mjs\" \"vite\"",
    "dev:server": "node --watch dist/src/server.mjs",
    "dev:client": "vite",
    "dev:desktop": "npm run build && electron dist/electron/main.mjs",
    "build": "npm run typecheck && npm run clean && tsup && vite build",
    "build:server": "tsc --noEmit -p tsconfig.json && tsup",
    "build:client": "tsc --noEmit -p client/tsconfig.json && vite build",
    "build:desktop": "npm run build:icons && npm run build && electron-builder",
    "daemon": "node dist/src/daemon/daemon.mjs",
    "start": "node dist/src/server.mjs",
    "start:all": "concurrently -n daemon,web \"npm run daemon\" \"npm run start\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p client/tsconfig.json",
    "dev:daemon": "node --watch dist/src/daemon/daemon.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --experimental-strip-types --no-warnings scripts/test-gates.mjs && node --experimental-strip-types --no-warnings scripts/test-gate-policy.mjs && node --experimental-strip-types --no-warnings scripts/test-gate-answer.mjs && node --experimental-strip-types --no-warnings scripts/test-voice-routing.mjs && node --experimental-strip-types --no-warnings scripts/test-approval-guard.mjs && node --experimental-strip-types --no-warnings scripts/test-gate-bridge.mjs && node --experimental-strip-types --no-warnings scripts/test-supervisor-fallback.mjs && node --experimental-strip-types --no-warnings scripts/test-utterance.mjs && node --experimental-strip-types --no-warnings scripts/test-voice-picker.mjs && node scripts/test-supervisor-concurrency.mjs && node scripts/test-storage-concurrency.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "browser-check": "node scripts/browser-check.mjs --deep",
    "test:supervisor": "node --experimental-strip-types --no-warnings scripts/test-supervisor.mjs",
    "build:icons": "node scripts/make-icons.mjs",
    "check:agents": "node scripts/check-agents.mjs",
    "check:multi": "node scripts/multi-agent-session.mjs",
    "check:keeper": "node scripts/test-keeper.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "check:abuse": "node scripts/check-abuse.mjs",
    "check:desktop": "node scripts/check-desktop.mjs",
    "check:nova": "node scripts/check-nova.mjs",
    "check:voice-live": "node scripts/check-voice-live.mjs",
    "check:ui": "node scripts/check-ui.mjs",
    "check:org": "node scripts/check-org.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "check:lifecycle": "node scripts/check-lifecycle.mjs",
    "check:bedrock": "node scripts/check-bedrock.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "icons": "node scripts/make-icons.mjs",
    "demo:reset": "node scripts/demo-reset.mjs",
    "architecture": "node scripts/make-architecture.mjs",
    "check:mermaid": "node scripts/check-mermaid.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.109.1",
    "@aws-sdk/client-bedrock-runtime": "^3.1124.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@strands-agents/sdk": "^1.16.0",
    "chokidar": "^5.0.0",
    "dotenv": "^16.6.1",
    "electron-updater": "^6.8.9",
    "express": "^4.21.0",
    "marked": "^18.0.0",
    "uuid": "^10.0.0",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.2.0-beta.12"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "concurrently": "^9.0.1",
    "dompurify": "^3.4.14",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.5",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vite": "^5.4.3"
  }
}
